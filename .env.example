# AfriMentor AI — environment variable reference
# Copy this file to .env and fill in real values.
# .env is gitignored; this file is safe to commit.

# ── LLM (Groq serverless — groq.com free tier) ────────────────────────────────
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# gpt-oss-20b replaced qwen/qwen3.6-27b (2026-08-30): qwen is a reasoning
# model that burns ~2000+ tokens on a hidden <think> trace before any visible
# answer, needing LLM_MAX_TOKENS>=4096 and reasoning_format=hidden just to
# get a clean response. gpt-oss-20b has no such trace — verified across
# varied prompts, 2048 is enough and finishes in ~1-2s. See
# docs/implementation/C5_1_final_evaluation.md for the comparison.
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ── Feature flags ──────────────────────────────────────────────────────────────
# Card C4.4 — gates beta personas (currently KWAME) in persona-prompt-service.
# Off by default; set true in the staging/test stack to make them selectable.
ENABLE_BETA_PERSONAS=false

# ── CHIOMA alignment condition ─────────────────────────────────────────────────
# Identifies which Sprint 4 research alignment condition is active (card D1.4).
# C4 (RLHF / Preference Optimization) is the selected winner — composite 0.654.
# Source: research/evaluation/results/comparative_results.json
# Update to "C4-gpu" once the AfriMentor/chioma-rlhf-v1 adapter is trained.
CHIOMA_ALIGNMENT_CONDITION=C4
