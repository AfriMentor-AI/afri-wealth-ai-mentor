# AfriMentor AI — environment variable reference
# Copy this file to .env and fill in real values.
# .env is gitignored; this file is safe to commit.

# ── LLM (Groq serverless — groq.com free tier) ────────────────────────────────
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# ── Feature flags ──────────────────────────────────────────────────────────────
# Card C4.4 — gates beta personas (currently KWAME) in persona-prompt-service.
# Off by default; set true in the staging/test stack to make them selectable.
ENABLE_BETA_PERSONAS=false
