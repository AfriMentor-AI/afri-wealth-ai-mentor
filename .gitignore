# MLflow local tracking artifacts
mlruns/

# Model checkpoints and weights
*.pt
*.bin
*.safetensors
optimizer.pt
research/models/
checkpoints/
# Ignore eval-run scratch output, but not the frozen canonical snapshots
# (card C5.1) - freeze_results.py calls those "immutable"; leaving them
# gitignored would mean the paper's citable dataset only ever exists on
# whichever machine ran the freeze, the exact failure mode that twice lost
# this card's raw eval output already. A directory-exclusion pattern (plain
# "results/") blocks re-inclusion of anything under it, so this ignores the
# directory's direct contents instead and carves the one subdirectory back out.
research/evaluation/results/*
!research/evaluation/results/canonical/

# Per-service SQLite dev fallback DBs (DATABASE_URL unset) and alembic scratch DBs
*.db

# Secrets / crypto keys (dev keys are generated at runtime, never committed)
infra/keys/
*.pem
*.key

# Local pg_dump output from scripts/backup/backup-postgres.sh (card O4.5) —
# real service data, never committed.
/backups/

# Audio data and uploads
*.mp3
*.wav

# Claude CI workflows — kept locally but not pushed (no API credits)
.github/workflows/claude-review.yml
.github/workflows/claude.yml
.claude/