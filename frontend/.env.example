# AfriMentor AI frontend — environment variable reference (card O2.4)
# Copy to .env.local (gitignored) and adjust if the gateway isn't on localhost:8000.

# API gateway base URL — used by lib/session.ts and lib/api.ts for the live
# Auth, Intake and Goals & Milestones calls. Defaults to the gateway's dev port
# (see docker-compose.yml) when unset, so this file is optional for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
