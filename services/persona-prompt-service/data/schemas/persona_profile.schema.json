{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afrimentor.ai/schemas/persona_profile.schema.json",
  "title": "Persona Target Profile Schema",
  "description": "Versioned machine-readable JSON specification for AI mentor persona target profiles.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "display_name",
    "traits"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trait_target"
      }
    },
    "distinctive_traits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trait_target"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "trait_target": {
      "type": "object",
      "required": [
        "key",
        "label",
        "target_level",
        "behaviour"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target_level": {
          "type": "string",
          "enum": [
            "VERY_LOW",
            "LOW",
            "MODERATE_LOW",
            "MODERATE",
            "MODERATE_HIGH",
            "HIGH",
            "VERY_HIGH"
          ]
        },
        "behaviour": {
          "type": "string",
          "minLength": 1
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counter_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
