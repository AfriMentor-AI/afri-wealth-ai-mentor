# Development values for the remote Compose host.
# Change these before exposing the remote host beyond a trusted network.
APP_ENV=dev
POSTGRES_USER=afrimentor
POSTGRES_PASSWORD=afrimentor
POSTGRES_DB=afrimentor
RABBITMQ_DEFAULT_USER=afrimentor
RABBITMQ_DEFAULT_PASS=afrimentor
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Required by chat-orchestration-service and research-evaluation-service.
LLM_API_KEY=replace-with-your-development-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_STREAMING_ENABLED=true
CHAT_CACHE_TTL_SECONDS=300
CHAT_CACHE_MAX_ENTRIES=256
GUARDRAILS_ENABLED=true
PROBE_TEMPERATURE=0.0
PROBE_MAX_TOKENS=512

# Used by the local frontend when it calls the remote gateway.
# Replace with the remote machine's VPN or LAN address.
REMOTE_HOST=192.168.1.100
REMOTE_GATEWAY_URL=http://${REMOTE_HOST}:8000
